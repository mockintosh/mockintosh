{
  "name": "mockintosh",
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx scripts/build-chat-context.ts && vite",
    "dev:ui": "npm run dev --prefix sites/ui",
    "build:ui": "npm run build --prefix sites/ui",
    "build": "npm run build:content && vite build",
    "preview": "vite preview",
    "dev:api": "tsx scripts/dev-api.ts",
    "build:content": "tsx scripts/build-chat-context.ts && tsx scripts/build-contributors.ts",
    "contributors:refresh": "tsx scripts/build-contributors.ts --refresh",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json && tsc -p tsconfig.host.json",
    "check:core": "tsc -p tsconfig.core.json",
    "agent:eval": "tsx scripts/agent-eval.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "companion": "tsx scripts/companion/main.ts",
    "mockintosh": "tsx scripts/cli/main.ts",
    "mockintosh-sh": "tsx scripts/mockintosh-sh.ts",
    "mcp": "tsx scripts/companion/mcp.ts",
    "test:m1": "tsx scripts/companion/demo.ts",
    "test:browser-build": "npm run build && tsx scripts/builder/browser-demo.ts",
    "apps:declarations": "UPDATE_DECLARATIONS=1 vitest run apps/declarations.test.ts",
    "wasi:build": "sh scripts/wasi/build.sh",
    "assets:unused": "tsx scripts/find-unused-assets.ts",
    "icons:find": "tsx scripts/find-icons.ts",
    "icons:import": "tsx scripts/import-icon.ts",
    "icons:refresh-catalog": "tsx scripts/refresh-icon-catalog.ts",
    "icons:gallery": "tsx scripts/icons-gallery.ts",
    "icons:preview": "tsx scripts/preview-icons.ts",
    "glyphs:ascii": "tsx scripts/preview-ascii-glyphs.ts --out /tmp/ascii-glyphs.png",
    "fonts:import-pixel": "python3 scripts/import-geist-pixel.py",
    "fonts:import-lisa": "python3 scripts/import-lisa-terminal.py",
    "fonts:import-bmfont": "python3 scripts/import-bmfont.py",
    "fonts:import-redaction": "tsx scripts/import-redaction.ts",
    "fonts:import-geneva-bold": "tsx scripts/import-geneva-bold.ts",
    "fonts:import-geneva-12": "python3 scripts/import-geneva-12.py && tsx scripts/import-geneva-12-bold.ts",
    "fonts:import-city": "python3 scripts/import-city-fonts.py",
    "fonts:preview-pixel": "tsx scripts/preview-pixel-font.ts",
    "icons:extract-753": "python3 scripts/extract-system753-icons.py",
    "resources:extract-753": "python3 scripts/extract-system753-resources.py"
  },
  "dependencies": {
    "@mockintosh/agent": "*",
    "@mockintosh/fs": "*",
    "@mockintosh/markdown": "*",
    "@mockintosh/print": "*",
    "@mockintosh/protocol": "*",
    "@mockintosh/quickdraw": "*",
    "@mockintosh/sdk": "*",
    "@mockintosh/terminal": "*",
    "@mockintosh/ui": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@rollup/browser": "^4.63.1",
    "@solidjs/compiler-wasm32-wasi": "2.0.0-rc.8",
    "@solidjs/web": "2.0.0-rc.8",
    "defuddle": "^0.14.0",
    "libfx": "0.0.13",
    "linkedom": "^0.18.12",
    "solid-js": "2.0.0-rc.8",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "@types/node": "^22.12.0",
    "@types/three": "^0.183.1",
    "@types/ws": "^8.18.1",
    "knip": "^5.86.0",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "ws": "^8.20.0"
  }
}
