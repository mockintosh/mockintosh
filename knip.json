{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "python3"
  ],
  "ignoreIssues": {
    "packages/ui/src/fonts/faces/redaction.ts": [
      "exports"
    ],
    "packages/quickdraw/**": [
      "exports",
      "types"
    ]
  },
  "workspaces": {
    ".": {
      "entry": [
        "api/**/*.ts",
        "src/3d/main.ts",
        "src/runtime/{sdk,solid}.ts",
        "scripts/*.{ts,mjs}",
        "scripts/builder/demo.ts",
        "scripts/companion/headlessRuntime.ts"
      ],
      "ignore": [
        "templates/**"
      ]
    },
    "packages/sdk": {
      "entry": [
        "examples/**/*.tsx"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/vite/dither-asset.d.ts"
      ]
    }
  }
}
