{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "WebWorker"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "target": "es2020",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "jsxImportSource": "@mockintosh/ui",
    "paths": {
      "@/*": ["./*"],
      "@mockintosh/quickdraw": ["./packages/quickdraw/src/index.ts"],
      "@mockintosh/quickdraw/bits": ["./packages/quickdraw/src/bits.ts"],
      "@mockintosh/terminal": ["./packages/terminal/src/index.ts"],
      "@mockintosh/terminal/view": ["./packages/terminal/src/view/index.ts"],
      "@mockintosh/terminal/bash": ["./packages/terminal/src/bash/index.ts"],
      "@mockintosh/terminal/wasi": ["./packages/terminal/src/wasi/index.ts"]
    },
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/protocol/src/**/*.ts",
    "packages/agent/src/**/*.ts",
    "packages/sdk/src/**/*.ts",
    "packages/sdk/src/**/*.tsx",
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx",
    "packages/fs/src/**/*.ts",
    "packages/print/src/**/*.ts",
    "packages/terminal/src/**/*.ts",
    "packages/terminal/src/**/*.tsx",
    "vite-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "api", "scripts", "packages/quickdraw", "packages/ui/src/vite/**"]
}
